{
  "name": "pixelkit-ai",
  "main": "src/index.js",
  "compatibility_date": "2026-10-28",
  "ai": { "binding": "AI" },
  "durable_objects": {
    "bindings": [
      { "name": "LIMITER", "class_name": "RateLimiter" },
      { "name": "SHARES", "class_name": "ShareStore" }
    ]
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["RateLimiter"] },
    { "tag": "v2", "new_sqlite_classes": ["ShareStore"] }
  ]
}
